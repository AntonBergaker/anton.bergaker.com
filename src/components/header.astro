---
import {
    header,
    firstName,
    contactLinks,
    diagonalLine,
} from "./header.module.scss";
import EmailSvg from "./svgs/email.astro";
import GithubSvg from "./svgs/github.astro";
import BlueskySvg from "./svgs/bluesky.astro";
---

<div id='header' class={header}>
    <a href='../'>
        <h1>
            <span class={firstName}>Anton</span> Bergåker
        </h1>
    </a>
    <p id='motto'>Now without random taglines!</p>
    <div class={contactLinks}>
        <a href='https://twitter.com/DragonCoke'>
            <BlueskySvg color='#55acee' />
        </a>
        <a href='https://github.com/AntonBergaker'>
            <GithubSvg color='#9c45aa' />
        </a>
        <a href='mailto:anton@bergaker.com'>
            <EmailSvg color='#eba745' />
        </a>
    </div>
</div>

<script>
    const mottos = [
        "Because programming needs spreadsheets",
        "Anton <3 coffee",
        "Probably not a scarecrow",
        "Probably not a chain chomp",
        "It works on my machine",
        "From Sweden with love",
        "We'll burn that bridge when we get there",
        "Let's add it to a list! Let's add the list to a list!",
        "You can do it 🎉",
        "Send me cute things!",
        "This message only appears if you're cute",
        "Those that commit last, commits longest",
        "Denying the furry allegations",
        "Big technology",
        "The power of fluffy boys shines within you",
        "This is a very Anton thing to say",
        "If we die, we die",
        "It isn't easy when it's difficult",
        "That's bomba",
        "🐸"
    ];
    const mottoElement = document.getElementById("motto");
    const motto = mottos[Math.floor(Math.random() * mottos.length)];
    if (!mottoElement) {
        console.log(`Did not find motto. Now the world won't know: ${motto}`)
    }
    mottoElement!.innerHTML = motto;
</script>
